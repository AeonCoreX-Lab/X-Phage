~link "aeon.core"

pulse core {
    shadow vault_key = "PHAGE-99X-ALPHA"
    shadow user_access = "ROOT_USER"
    
    beam "--- Security Protocol Initiated ---"
    beam "Accessing Ghost Memory..."
    beam user_access
    
    scan user_access {
        beam "Decryption Successful."
        beam vault_key
    }
}
