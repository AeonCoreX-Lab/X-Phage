#define FUSION_VERSION "3.1.0"
#define RENDER_BACKEND "SDL2_OPENGL"

// --- Global UI State ---
global UI_THEME = "DARK_MATTER"
global RENDER_MODE = "HARDWARE_ACCELERATED"
global ANIMATION_SPEED = "OMNI_FAST"

// --- Standard UI Atoms & Shadows ---
atom MAX_FPS = "60"
atom WINDOW_WIDTH = "1280"
atom WINDOW_HEIGHT = "720"

shadow current_screen = "SPLASH_SCREEN"
shadow ui_pulse_rate = "15ms"

// --- System Hooks (Connecting to C++ Engine) ---
~hook gpu_renderer -> fusion_core
~hook window_manager -> display_matrix
~hook input_event -> touch_synapse

// --- Neural Components Configuration ---
// এগুলো আপনার X-Phage C++ ইঞ্জিন সরাসরি রেন্ডার করবে
@Function(Vortex)  -> { Layout: "FlexColumn", Alignment: "Center", Optimization: "Extreme" }
@Function(Orbit)   -> { Layout: "FlexRow", Spacing: "Dynamic", Latency: "Zero" }
@Function(Signal)  -> { Type: "Typography", Color: "Neural_Aura", Font: "Aeon_Sans" }
@Function(Vision)  -> { Type: "MediaStream", Decode: "Hardware_H265" }
@Function(Trigger) -> { Type: "Interactive", Action: "KernelInterrupt", Feedback: "Haptic" }

// Init Message
beam ">> [FUSION_MODULE] Visual Canvas matrix loaded successfully."
