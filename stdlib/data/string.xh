// X-Phage String & Buffer Manipulation v1.0
// Optimized for zero-copy memory mapping

pulse string_split(target, delimiter) {
    beam ">> Splitting string in Shadow RAM..."
    bypass str_util {
        op: "split",
        input: target,
        sep: delimiter
    }
}

pulse string_replace(target, old_val, new_val) {
    bypass str_util {
        op: "replace",
        input: target,
        find: old_val,
        replace: new_val
    }
}

pulse string_to_upper(target) {
    bypass str_util {
        op: "uppercase",
        input: target
    }
}

pulse string_regex_match(target, pattern) {
    bypass str_regex {
        input: target,
        regex: pattern
    }
}
