// X-Phage HTTP/REST Protocol v1.0
// Ownership: AeonCoreX

@NeuralComposition(Net_Stack) {
    global TIMEOUT_MS = "5000"
    ~hook net_tcp -> "os_socket_layer"
}

pulse http_get(url) {
    beam ">> Executing Neural GET Request -> " + url
    bypass curl_engine {
        target: url,
        method: "GET",
        timeout: TIMEOUT_MS
    }
}

pulse http_post(url, payload) {
    beam ">> Pushing Data Payload to -> " + url
    bypass curl_engine {
        target: url,
        method: "POST",
        body: payload
    }
}
