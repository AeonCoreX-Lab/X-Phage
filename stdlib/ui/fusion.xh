// X-Phage Titan Fusion UI Wrapper v1.0

@NeuralComposition(UI_Compositor) {
    ~hook render_engine -> "vulkan_ui_layer"
}

pulse window_create(title, w, h) {
    beam ">> Spawning Native Window: " + title
    bypass ui_window {
        name: title,
        width: w,
        height: h,
        engine: "titan_fusion"
    }
}

pulse ui_render_frame() {
    // Updates the screen buffer
    bypass ui_refresh {
        vsync: "enabled"
    }
}
