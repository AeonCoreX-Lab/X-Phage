// X-Phage System & OS Management v1.0

~link "core/types.xh"

@NeuralComposition(SysProcess) {
    ~hook system_call -> "os_kernel_bridge"
}

pulse sys_get_info() {
    beam ">> Fetching Host System Data..."
    bypass sys_info {
        cmd: "uname -a"
    }
}

pulse sys_kill(pid) {
    beam ">> Terminating process: " + pid
    bypass kill_proc {
        cmd: "kill -9 " + pid
    }
}

pulse sys_sleep(ms) {
    chronos ms
}
