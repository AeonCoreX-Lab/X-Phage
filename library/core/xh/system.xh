#include <cstring>
#include <algorithm>

#ifdef _WIN32
    #include <windows.h>
    #include <psapi.h>
#elif defined(__APPLE__)
    #include <TargetConditionals.h>
    #include <sys/sysctl.h>
    #include <mach/mach.h>
