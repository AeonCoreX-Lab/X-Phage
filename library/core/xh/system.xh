// ============================================================
// X-Phage Standard Library — core/system.xh
// System / OS Module v3.5.0
//
// v3.4.0: OS detection, process management, signal handling
// v3.5.0: Process spawn with stdout capture, environment
//          variable management, system metrics, cross-platform
//          path utilities, async process execution
//
// Usage:
//   ~link core/system
//
//   beam sys.os()              // "linux" / "macos" / "windows"
//   beam sys.arch()            // "x64" / "arm64"
//   pulse out = sys.exec("ls -la")
//   sys.setenv("KEY", "value")
//   beam sys.getenv("HOME")
// ============================================================

#pragma once
#include <string>
#include <vector>
#include <map>
#include <functional>
#include <thread>
#include <cstdlib>
#include <iostream>
#include <fstream>
#include <sstream>
