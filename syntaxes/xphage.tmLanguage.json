{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "X-Phage",
  "scopeName": "source.xphage",
  "fileTypes": ["xp0", "xh", "xui"],
  "patterns": [
    {
      "name": "keyword.control.xphage",
      "match": "\\b(pulse|core|scan|bypass|~link|quantum|vortex|synapse|chronos|ether|void|global|fusion)\\b"
    },
    {
      "name": "entity.name.type.ui.xphage",
      "match": "@[a-zA-Z_]+"
    },
    {
      "name": "support.class.ui.xphage",
      "match": "\\b(Signal|Vision|Orbit|Trigger|Vortex)\\b"
    },
    {
      "name": "storage.type.xphage",
      "match": "\\b(atom|shadow|matrix)\\b"
    },
    {
      "name": "entity.name.function.xphage",
      "match": "\\b(beam)\\b"
    },
    {
      "name": "string.quoted.double.xphage",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.xphage",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "comment.line.double-slash.xphage",
      "match": "//.*$"
    },
    {
      "name": "comment.block.xphage",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "keyword.operator.xphage",
      "match": "\\+|\\-|\\*|\\/|=|->|~"
    },
    {
      "name": "constant.numeric.xphage",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b|\\b0x[0-9a-fA-F]+\\b"
    }
  ],
  "repository": {},
  "uuid": "aeon-core-x-phage-syntax"
}
